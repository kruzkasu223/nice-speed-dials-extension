{
  "name": "nice-speed-dials-extension",
  "version": "6.0.0",
  "license": "GPL-3.0-only",
  "keywords": [
    "browser",
    "extension",
    "speed dials",
    "solid",
    "solidjs"
  ],
  "author": {
    "name": "Krushang Kasundra",
    "url": "https://kruz.me"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kruzkasu223/nice-speed-dials-extension"
  },
  "description": "A fast, calm, and customizable new-tab page powered by your browser bookmarks.",
  "type": "module",
  "scripts": {
    "prepare": "wxt prepare",
    "dev": "wxt --mv3",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build --mv3",
    "build:firefox": "wxt build -b firefox --mv3",
    "zip": "wxt zip --mv3 && cp .output/extension-chrome.zip extension-chrome.zip",
    "zip:firefox": "wxt zip -b firefox --mv3 && cp .output/extension-firefox.zip extension-firefox.zip",
    "zip:edge": "wxt zip -b edge --mv3 && cp .output/extension-edge.zip extension-edge.zip",
    "zip:all": "wxt zip --mv3 && wxt zip -b firefox --mv3 && wxt zip -b edge --mv3 && cp .output/extension-chrome.zip extension-chrome.zip && cp .output/extension-firefox.zip extension-firefox.zip && cp .output/extension-edge.zip extension-edge.zip",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.0",
    "@types/chrome": "0.2.7",
    "@wxt-dev/module-solid": "1.1.4",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.0",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vite-plugin-solid": "2.11.14",
    "wxt": "0.21.4"
  },
  "dependencies": {
    "@ark-ui/solid": "5.39.0",
    "caniuse-lite": "1.0.30001809",
    "clsx": "2.1.1",
    "lucide-solid": "1.33.0",
    "solid-dnd-directive": "0.2.0",
    "solid-js": "1.9.15",
    "tailwind-merge": "3.6.0"
  }
}
